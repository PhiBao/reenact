    "start_path": "/",
    "preconditions": [
      "the user is signed in and the memo editor is visible on the home page"
    ],
    "steps": [
      "Click on the memo editor text area",
      "Type \"- 123\"",
      "Press the Enter key"
    ],
    "expected": "The first line of the editor still reads \"- 123\" with nothing appended, and a new second line begins with \"- \" to continue the list.",
    "reported_actual": "After pressing Enter, the current line becomes \"- 123-\" (or \"* 123*\") and the list symbol is appended to the existing line instead of a new line.",
    "missing": [
      "assumed: the 'Markdown editor in the content publishing interface' is the memo editor on the home page",
